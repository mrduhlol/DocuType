{
  "manifest_version": 3,
  "name": "DocuType",
  "version": "1.0.0",
  "description": "Guided typing practice for Google Docs. DocuType reveals a passage; you type it yourself.",
  "minimum_chrome_version": "105",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "DocuType — guided typing practice",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
